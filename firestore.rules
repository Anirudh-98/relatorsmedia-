rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================
    // ROLES
    //   admin  - admin@realtorsmedia.com (manages issuers, sees every card)
    //   issuer - active `staff/{uid}` record created by the admin (employee cards)
    //   member - any signed-in user, limited to their own records
    //   public - anyone: verification lookups and guest submissions only
    // ========================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'admin@realtorsmedia.com';
    }

    // Active ID card issuer login (created by the admin, see `staff`)
    function isIssuer() {
      let staffPath = /databases/$(database)/documents/staff/$(request.auth.uid);
      return isAuthenticated() && exists(staffPath) && get(staffPath).data.active == true;
    }

    function isStaff() {
      return isAdmin() || isIssuer();
    }

    // Public single-record lookups (verification, login, password reset) are allowed;
    // bulk listing of personal data is not
    function isSingleLookup() {
      return request.query.limit <= 1;
    }

    function isShortString(value, max) {
      return value is string && value.size() <= max;
    }

    // ========================================================
    // 1. MEMBERS (`members/{uid}`)
    // ========================================================
    match /members/{memberId} {
      allow get: if true;
      allow list: if isSingleLookup() || isAdmin();

      // A member creates only their own profile (document id == their uid)
      allow create: if isAuthenticated()
        && request.auth.uid == memberId
        && request.resource.data.uid == request.auth.uid;

      // A member updates only their own profile; ownership cannot be reassigned
      allow update: if isAdmin() || (
        isAuthenticated()
        && (request.auth.uid == memberId || request.auth.uid == resource.data.uid)
        && request.resource.data.uid == request.auth.uid
        && !(resource.data.get('status', '') == 'SUSPENDED' && request.resource.data.get('status', '') != 'SUSPENDED')
      );

      allow delete: if isAdmin() || (
        isAuthenticated() && (request.auth.uid == memberId || request.auth.uid == resource.data.uid)
      );
    }

    // ========================================================
    // 2. ID CARDS REGISTRY (`idCards/{cardId}`)
    // ========================================================
    match /idCards/{cardId} {
      // Public QR verification (/verify/[id]) reads one card at a time
      allow get: if true;
      allow list: if isSingleLookup()
        || isAdmin()
        || (isIssuer() && resource.data.cardType == 'employee');

      // A member's own card: never an employee card, never an RM-E-* ID,
      // and the document id must match the card's employeeId
      function isOwnMemberCard() {
        let d = request.resource.data;
        return isAuthenticated()
          && d.uid == request.auth.uid
          && d.get('cardType', 'member') == 'member'
          && d.get('employeeId', cardId) == cardId
          && !cardId.upper().matches('^RM-E-.*');
      }

      allow create: if isAdmin()
        || (isIssuer() && request.resource.data.cardType == 'employee')
        || isOwnMemberCard();

      allow update: if isAdmin()
        || (isIssuer() && resource.data.cardType == 'employee' && request.resource.data.cardType == 'employee')
        || (
          isOwnMemberCard()
          && resource.data.uid == request.auth.uid
          && resource.data.get('cardType', 'member') == 'member'
          // A card suspended by the admin cannot be re-activated by its owner
          && !(resource.data.get('status', '') == 'SUSPENDED' && request.resource.data.get('status', '') != 'SUSPENDED')
        );

      allow delete: if isAdmin();
    }

    // ========================================================
    // 3. PROPERTY LISTINGS (`properties/{propertyId}`)
    // Guests may post; only the author or the admin may edit or remove
    // ========================================================
    match /properties/{propertyId} {
      allow get, list: if true;

      allow create: if request.resource.data.keys().hasOnly([
          'title', 'propertyType', 'listingType', 'city', 'locality', 'price', 'area', 'bhk',
          'reraNumber', 'name', 'phone', 'email', 'role', 'description', 'imageUrl',
          'authorUid', 'status', 'views', 'leads', 'createdAt'
        ])
        && isShortString(request.resource.data.title, 200)
        && isShortString(request.resource.data.name, 100)
        && isShortString(request.resource.data.phone, 30)
        && isShortString(request.resource.data.get('description', ''), 5000)
        && isShortString(request.resource.data.get('imageUrl', ''), 2048)
        && request.resource.data.status == 'Active'
        && request.resource.data.get('views', 0) is int && request.resource.data.get('views', 0) <= 1
        && request.resource.data.get('leads', 0) == 0
        && (
          (isAuthenticated() && request.resource.data.authorUid == request.auth.uid)
          || (!isAuthenticated() && request.resource.data.authorUid == 'guest')
        );

      function isAuthor() {
        return isAuthenticated()
          && resource.data.get('authorUid', '') != 'guest'
          && (request.auth.uid == resource.data.get('authorUid', '') || request.auth.uid == resource.data.get('uid', ''));
      }

      // Anyone may bump the view / lead counters by one; nothing else
      function isCounterBump() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly(['views', 'leads'])
          && request.resource.data.get('views', 0) - resource.data.get('views', 0) <= 1
          && request.resource.data.get('views', 0) >= resource.data.get('views', 0)
          && request.resource.data.get('leads', 0) - resource.data.get('leads', 0) <= 1
          && request.resource.data.get('leads', 0) >= resource.data.get('leads', 0);
      }

      allow update: if isAdmin()
        || (isAuthor() && request.resource.data.authorUid == resource.data.authorUid)
        || isCounterBump();

      allow delete: if isAdmin() || isAuthor();
    }

    // ========================================================
    // 4. LEADS & INQUIRIES (`leads/{leadId}`)
    // Anyone may submit; only the member the lead belongs to (or the admin) may see it
    // ========================================================
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'phone', 'email', 'propertyId', 'propertyName', 'budget', 'message',
          'memberUid', 'status', 'createdAt'
        ])
        && isShortString(request.resource.data.name, 100)
        && isShortString(request.resource.data.phone, 30)
        && isShortString(request.resource.data.get('message', ''), 2000)
        && request.resource.data.status == 'New';

      allow get, list: if isAdmin()
        || (isAuthenticated() && resource.data.get('memberUid', '') == request.auth.uid);

      allow update: if isAdmin() || (
        isAuthenticated()
        && resource.data.get('memberUid', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      );

      allow delete: if isAdmin()
        || (isAuthenticated() && resource.data.get('memberUid', '') == request.auth.uid);
    }

    // ========================================================
    // 5. SEQUENTIAL ID COUNTERS (`counters/{counterId}`)
    // Written while a card is issued; can only move forward
    // ========================================================
    match /counters/{counterId} {
      // Public to preview the next ID on the register page
      allow get: if true;
      allow list: if isAdmin();

      function isValidCounterWrite() {
        let d = request.resource.data;
        return isAuthenticated()
          && (counterId == 'memberSequence' || (counterId == 'employeeSequence' && isStaff()))
          && d.currentSequence is int
          && d.currentSequence > 1110
          && d.currentSequence < 100000000;
      }

      allow create: if isValidCounterWrite()
        && request.resource.data.keys().hasOnly(['currentSequence', 'lastEmployeeId', 'lastPrefix', 'updatedAt']);

      allow update: if isValidCounterWrite()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentSequence', 'lastEmployeeId', 'lastPrefix', 'updatedAt'])
        && request.resource.data.currentSequence >= resource.data.get('currentSequence', 0);

      allow delete: if isAdmin();
    }

    // ========================================================
    // 6. ID CARD ISSUER LOGIN (`staff/{uid}`)
    // Managed by the admin from /admin; the issuer can only read its own record
    // ========================================================
    match /staff/{uid} {
      allow get: if isAdmin() || (isAuthenticated() && request.auth.uid == uid);
      allow list, create, update, delete: if isAdmin();
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
