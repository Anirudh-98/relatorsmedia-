rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'admin@realtorsmedia.com';
    }

    // Active ID card issuer login (created by the admin, see `staff`)
    function isIssuer() {
      let staffPath = /databases/$(database)/documents/staff/$(request.auth.uid);
      return isAuthenticated() && exists(staffPath) && get(staffPath).data.active == true;
    }

    // ========================================================
    // 1. MEMBERS COLLECTION (`members/{memberId}`)
    // Full CRUD operations for member accounts
    // ========================================================
    match /members/{memberId} {
      // READ: Public for directory and member profile verification
      allow get, list: if true;
      
      // CREATE: Authenticated user creating their own member profile on enrollment
      allow create: if isAuthenticated() && (request.auth.uid == memberId || request.auth.uid == request.resource.data.uid);
      
      // UPDATE: Only the authenticated member can update their own profile
      allow update: if isAuthenticated() && (request.auth.uid == memberId || request.auth.uid == resource.data.uid);
      
      // DELETE: Authenticated member deleting their account
      allow delete: if isAuthenticated() && (request.auth.uid == memberId || request.auth.uid == resource.data.uid);
    }

    // ========================================================
    // 2. ID CARDS REGISTRY (`idCards/{cardId}`)
    // Full CRUD operations for ID card generation and QR verification
    // ========================================================
    match /idCards/{cardId} {
      // READ: Public for QR code scanning & credential verification (/verify/[id])
      allow get, list: if true;
      
      // CREATE: the admin, the issuer login (employee cards), or a member issuing their own card
      allow create: if isAdmin()
        || (isIssuer() && request.resource.data.cardType == 'employee')
        || (isAuthenticated() && request.resource.data.uid == request.auth.uid);

      // UPDATE: the admin, the issuer login (employee cards only), or the member who owns
      // the card (ownership cannot be reassigned)
      allow update: if isAdmin()
        || (isIssuer() && resource.data.cardType == 'employee' && request.resource.data.cardType == 'employee')
        || (
          isAuthenticated() &&
          resource.data.uid == request.auth.uid &&
          request.resource.data.uid == request.auth.uid
        );

      // DELETE: admin only
      allow delete: if isAdmin();
    }

    // ========================================================
    // 3. PROPERTY LISTINGS (`properties/{propertyId}`)
    // Full CRUD operations for real estate property marketplace
    // ========================================================
    match /properties/{propertyId} {
      // READ: Public for property search and listings
      allow get, list: if true;
      
      // CREATE: Authenticated members or registered posters
      allow create: if isAuthenticated() || true;
      
      // UPDATE: Poster can edit property details, or public view/inquiry counter increment
      allow update: if true;
      
      // DELETE: Only the property author can remove their listing
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.authorUid || request.auth.uid == resource.data.uid);
    }

    // ========================================================
    // 4. LEADS & INQUIRIES (`leads/{leadId}`)
    // Full CRUD operations for client inquiries and buyer leads
    // ========================================================
    match /leads/{leadId} {
      // CREATE: Prospective buyers submitting contact inquiries
      allow create: if true;
      
      // READ: Authenticated agents and team members
      allow get, list: if isAuthenticated();
      
      // UPDATE, DELETE: Authenticated lead recipient/manager
      allow update, delete: if isAuthenticated();
    }

    // ========================================================
    // 5. SEQUENTIAL ID COUNTERS (`counters/{counterId}`)
    // Atomic sequential member issuance (1111, 1112...)
    // ========================================================
    match /counters/{counterId} {
      // READ: Public to preview next available sequential ID on register page
      allow get: if true;
      allow list: if isAuthenticated();
      
      // CREATE, UPDATE: Managed atomically during enrollment transactions
      allow create, update: if true;
      
      // DELETE: Administrative reset only
      allow delete: if isAuthenticated();
    }

    // ========================================================
    // 6. ID CARD ISSUER LOGIN (`staff/{uid}`)
    // Managed by the admin from /admin; the issuer can only read its own record
    // ========================================================
    match /staff/{uid} {
      allow get: if isAdmin() || (isAuthenticated() && request.auth.uid == uid);
      allow list, create, update, delete: if isAdmin();
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
