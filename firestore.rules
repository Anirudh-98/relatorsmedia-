rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================
    // ROLES
    //   admin  - admin@realtorsmedia.com (manages issuers, properties, sees every card)
    //   issuer - active `staff/{uid}` record created by the admin (employee cards)
    //   member - any signed-in user, limited to their own records
    //   public - anyone: single ID card verification and inquiry submissions only
    // ========================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && 'email' in request.auth.token
        && request.auth.token.email.lower() == 'admin@realtorsmedia.com';
    }

    // Active ID card issuer login (created by the admin, see `staff`)
    function isIssuer() {
      let staffPath = /databases/$(database)/documents/staff/$(request.auth.uid);
      return isAuthenticated() && exists(staffPath) && get(staffPath).data.active == true;
    }

    function isStaff() {
      return isAdmin() || isIssuer();
    }

    function isShortString(value, max) {
      return value is string && value.size() <= max;
    }

    // The signed-in user's own record, matched by uid or by their login email (older records)
    function isOwnRecord() {
      return isAuthenticated() && (
        resource.data.get('uid', '') == request.auth.uid
        || ('email' in request.auth.token && resource.data.get('email', '') == request.auth.token.email)
      );
    }

    // A field the write leaves as it was (older records may hold values the checks below reject)
    function isUnchanged(key) {
      return resource != null && request.resource.data.get(key, null) == resource.data.get(key, null);
    }

    function isMemberTier(tier) {
      return tier in ['green', 'blue', 'orange'];
    }

    // Member card IDs: RM-A (orange), RM-B (blue), RM-C (green). RM-E is reserved for employee cards
    function isMemberCardIdForTier(id, tier) {
      return id is string
        && id.upper().matches('RM-[ABC]-[0-9]{4,8}')
        && id.upper().matches((tier == 'orange' ? 'RM-A' : (tier == 'blue' ? 'RM-B' : 'RM-C')) + '-.*');
    }

    function isMemberDesignation(value) {
      return value in [
        'VERIFIED REALTOR', 'EXECUTIVE REALTOR', 'VIP ELITE REALTOR',
        'BUILDER / DEVELOPER', 'INDUSTRY PROFESSIONAL'
      ];
    }

    // Photos live in Firebase Storage; a small inline image or a bundled preset is also accepted
    function isSafePhoto(value) {
      return value is string
        && value.size() <= 900000
        && value.matches('(https://firebasestorage[.]googleapis[.]com/.*|data:image/(jpeg|png|webp);base64,.*|/[^/].*)?');
    }

    // Cards are valid for two years from issue (one extra year of slack for time zones)
    function isSaneValidTill(value) {
      return value is string
        && value.size() <= 20
        && value.matches('.*[0-9]{4}')
        && int(value[value.size() - 4:value.size()]) <= request.time.year() + 3;
    }

    function isIssuedByShape(data) {
      return !('issuedBy' in data)
        || (data.issuedBy is map && data.issuedBy.keys().hasOnly(['uid', 'loginId', 'name']));
    }

    // Checks shared by a member's own `members` profile and `idCards` record
    function hasValidMemberCardFields(data, tierKey, idValue) {
      return (isUnchanged(tierKey) || isMemberTier(data.get(tierKey, '')))
        && (isUnchanged('designation') || isMemberDesignation(data.get('designation', '')))
        && (isUnchanged('validTill') || isSaneValidTill(data.get('validTill', '')))
        && (isUnchanged('photoUrl') || isSafePhoto(data.get('photoUrl', '')))
        && (isUnchanged('photo') || isSafePhoto(data.get('photo', '')))
        && ((isUnchanged(tierKey) && isUnchanged('employeeId')) || isMemberCardIdForTier(idValue, data.get(tierKey, '')))
        && isShortString(data.get('fullName', ''), 100)
        && isShortString(data.get('name', ''), 100)
        && isShortString(data.get('phone', ''), 30)
        && isShortString(data.get('mobile', ''), 30)
        && isShortString(data.get('email', ''), 200)
        && isShortString(data.get('location', ''), 200)
        && isShortString(data.get('agencyName', ''), 200)
        && isShortString(data.get('licenseNumber', ''), 100)
        && isShortString(data.get('experience', ''), 100)
        && isShortString(data.get('specialization', ''), 200)
        && isShortString(data.get('department', ''), 100)
        && isShortString(data.get('issuedDate', ''), 20)
        && isShortString(data.get('verificationUrl', ''), 300)
        && isIssuedByShape(data);
    }

    // ========================================================
    // 1. MEMBERS (`members/{uid}`)
    // Private: only the member and the admin can read a profile
    // ========================================================
    match /members/{memberId} {
      allow get: if isAdmin() || (isAuthenticated() && request.auth.uid == memberId) || isOwnRecord();
      allow list: if isAdmin() || isOwnRecord();

      function memberKeys() {
        return [
          'uid', 'fullName', 'name', 'phone', 'mobile', 'email', 'city', 'state', 'location',
          'agencyName', 'companyName', 'licenseNumber', 'reraNo', 'experience', 'experienceYears',
          'specialization', 'photoUrl', 'photo', 'memberType', 'selectedTier', 'tier', 'cardTier', 'cardType',
          'employeeId', 'department', 'designation', 'verificationUrl', 'status', 'issuedDate',
          'validTill', 'issuedBy', 'replacedBy', 'createdAt', 'updatedAt'
        ];
      }

      // A member writes only their own profile, and can only ever set it ACTIVE
      function isOwnValidProfile() {
        let d = request.resource.data;
        return isAuthenticated()
          && request.auth.uid == memberId
          && d.uid == request.auth.uid
          && d.get('status', 'ACTIVE') == 'ACTIVE'
          && hasValidMemberCardFields(d, 'selectedTier', d.get('employeeId', ''))
          && isShortString(d.get('city', ''), 100)
          && isShortString(d.get('state', ''), 100)
          && isShortString(d.get('companyName', ''), 200)
          && isShortString(d.get('reraNo', ''), 100)
          && isShortString(d.get('experienceYears', ''), 100);
      }

      allow create: if isAdmin()
        || (isOwnValidProfile() && request.resource.data.keys().hasOnly(memberKeys()));

      // A profile suspended by the admin cannot be changed (or re-activated) by its owner
      allow update: if isAdmin() || (
        isOwnValidProfile()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(memberKeys())
        && resource.data.get('status', '') != 'SUSPENDED'
      );

      // Deleting and re-creating a profile would undo a suspension
      allow delete: if isAdmin();
    }

    // ========================================================
    // 2. ID CARDS REGISTRY (`idCards/{cardId}`)
    // ========================================================
    match /idCards/{cardId} {
      // Public QR verification (/verify/[id]) reads one card by its ID.
      // Listing is limited to staff and to a member's own cards
      allow get: if true;
      allow list: if isAdmin()
        || (isIssuer() && resource.data.cardType == 'employee')
        || isOwnRecord();

      function memberCardKeys() {
        return [
          'employeeId', 'fullName', 'name', 'phone', 'mobile', 'email', 'location', 'agencyName',
          'licenseNumber', 'experience', 'specialization', 'photoUrl', 'photo', 'cardTier',
          'department', 'designation', 'issuedDate', 'validTill', 'status', 'verificationUrl',
          'uid', 'cardType', 'issuedBy', 'replacedBy', 'createdAt', 'updatedAt'
        ];
      }

      // A member's own card: never an employee card, never an RM-E-* ID,
      // and the document id must match the card's employeeId
      function isOwnMemberCard() {
        let d = request.resource.data;
        return isAuthenticated()
          && d.uid == request.auth.uid
          && d.get('cardType', 'member') == 'member'
          && d.get('employeeId', cardId) == cardId
          && !cardId.upper().matches('RM-E-.*')
          && hasValidMemberCardFields(d, 'cardTier', cardId);
      }

      // New member IDs must come from the tier's sequence: at most a few numbers past its counter
      function isWithinIssuedSequence() {
        let id = cardId.upper();
        let counterId = id.matches('RM-A-.*')
          ? 'memberSequence_orange'
          : (id.matches('RM-B-.*') ? 'memberSequence_blue' : 'memberSequence_green');
        let counterPath = /databases/$(database)/documents/counters/$(counterId);
        let legacyPath = /databases/$(database)/documents/counters/memberSequence;
        let base = exists(counterPath)
          ? get(counterPath).data.currentSequence
          : (exists(legacyPath) ? get(legacyPath).data.currentSequence : 1110);
        let number = int(id.split('-')[2]);
        return number >= 1111 && number <= base + 50;
      }

      // A member whose profile was suspended by the admin cannot issue themselves a new card
      function isNotSuspendedMember() {
        let memberPath = /databases/$(database)/documents/members/$(request.auth.uid);
        return !exists(memberPath) || get(memberPath).data.get('status', '') != 'SUSPENDED';
      }

      allow create: if isAdmin()
        || (isIssuer() && request.resource.data.cardType == 'employee')
        || (
          isOwnMemberCard()
          && request.resource.data.keys().hasOnly(memberCardKeys())
          && request.resource.data.status == 'ACTIVE'
          && isWithinIssuedSequence()
          && isNotSuspendedMember()
        );

      allow update: if isAdmin()
        || (isIssuer() && resource.data.cardType == 'employee' && request.resource.data.cardType == 'employee')
        || (
          isOwnMemberCard()
          && resource.data.uid == request.auth.uid
          && resource.data.get('cardType', 'member') == 'member'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(memberCardKeys())
          // The owner can keep a card active or retire it; a suspended or retired card stays that way
          && request.resource.data.get('status', '') in ['ACTIVE', 'SUPERSEDED']
          && !(resource.data.get('status', '') in ['SUSPENDED', 'SUPERSEDED'])
        );

      allow delete: if isAdmin();
    }

    // ========================================================
    // 3. PROPERTY LISTINGS (`properties/{propertyId}`)
    // Restricted creation to the Administrator Dashboard ONLY
    // Public read for marketplace and category browsing
    // ========================================================
    match /properties/{propertyId} {
      allow get, list: if true;

      // Only Administrator can create verified properties
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'title', 'propertyType', 'listingType', 'city', 'locality', 'address', 'price', 'area', 'bhk',
          'bathrooms', 'furnishing', 'facing', 'reraNumber', 'name', 'phone', 'email', 'role',
          'description', 'imageUrl', 'images', 'mapUrl', 'googleMapUrl', 'memberId', 'agencyName',
          'amenities', 'authorUid', 'status', 'views', 'leads', 'createdAt', 'updatedAt'
        ])
        && isShortString(request.resource.data.title, 200)
        && isShortString(request.resource.data.name, 100)
        && isShortString(request.resource.data.phone, 30)
        && isShortString(request.resource.data.get('description', ''), 5000)
        && isShortString(request.resource.data.get('imageUrl', ''), 2048)
        && isShortString(request.resource.data.get('googleMapUrl', ''), 2048)
        && isShortString(request.resource.data.get('mapUrl', ''), 2048)
        && isShortString(request.resource.data.get('address', ''), 500)
        && isShortString(request.resource.data.get('memberId', ''), 50)
        && (!('images' in request.resource.data) || (request.resource.data.images is list && request.resource.data.images.size() <= 5))
        && (!('amenities' in request.resource.data) || (request.resource.data.amenities is list && request.resource.data.amenities.size() <= 30))
        && request.resource.data.status in ['Active', 'Under Offer', 'Sold'];

      // The admin can change anything. The member a listing is linked to (authorUid)
      // can only change its status, and can remove it
      allow update: if isAdmin() || (
        isAuthenticated()
        && resource.data.get('authorUid', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['Active', 'Under Offer', 'Sold']
      );

      allow delete: if isAdmin()
        || (isAuthenticated() && resource.data.get('authorUid', '') == request.auth.uid);
    }

    // ========================================================
    // 4. LEADS & INQUIRIES (`leads/{leadId}`)
    // Anyone may submit; only the member the lead belongs to (or the admin) may see it
    // ========================================================
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'phone', 'email', 'propertyId', 'propertyName', 'budget', 'message',
          'memberUid', 'status', 'createdAt'
        ])
        && isShortString(request.resource.data.name, 100)
        && isShortString(request.resource.data.phone, 30)
        && isShortString(request.resource.data.get('email', ''), 200)
        && isShortString(request.resource.data.get('propertyId', ''), 100)
        && isShortString(request.resource.data.get('propertyName', ''), 200)
        && isShortString(request.resource.data.get('budget', ''), 100)
        && isShortString(request.resource.data.get('message', ''), 2000)
        && isShortString(request.resource.data.get('memberUid', ''), 128)
        && request.resource.data.status == 'New';

      allow get, list: if isAdmin()
        || (isAuthenticated() && resource.data.get('memberUid', '') == request.auth.uid);

      allow update: if isAdmin() || (
        isAuthenticated()
        && resource.data.get('memberUid', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      );

      allow delete: if isAdmin()
        || (isAuthenticated() && resource.data.get('memberUid', '') == request.auth.uid);
    }

    // ========================================================
    // 5. CLASSIFIEDS (`classifieds/{adId}`)
    // Public directory; ads are published by the admin
    // ========================================================
    match /classifieds/{adId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // ========================================================
    // 6. SEQUENTIAL ID COUNTERS (`counters/{counterId}`)
    // Written while a card is issued; can only move forward, a few numbers at a time
    // ========================================================
    match /counters/{counterId} {
      // Public to preview the next ID on the register page
      allow get: if true;
      allow list: if isAdmin();

      function isMemberCounter() {
        return counterId in ['memberSequence_green', 'memberSequence_blue', 'memberSequence_orange'];
      }

      function isEmployeeCounter() {
        return counterId == 'employeeSequence' && isStaff();
      }

      function hasValidSequence() {
        let d = request.resource.data;
        return isAuthenticated()
          && (isMemberCounter() || isEmployeeCounter())
          && d.currentSequence is int
          && d.currentSequence > 1110
          && d.currentSequence < 100000000;
      }

      // Where a tier's numbering starts: 1111, or after the older shared `memberSequence` counter
      function startingSequence() {
        let legacyPath = /databases/$(database)/documents/counters/memberSequence;
        return exists(legacyPath) ? get(legacyPath).data.currentSequence : 1110;
      }

      allow create: if isAdmin() || (
        hasValidSequence()
        && request.resource.data.keys().hasOnly(['currentSequence', 'lastEmployeeId', 'lastPrefix', 'updatedAt'])
        && (isEmployeeCounter() || request.resource.data.currentSequence <= startingSequence() + 50)
      );

      allow update: if isAdmin() || (
        hasValidSequence()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentSequence', 'lastEmployeeId', 'lastPrefix', 'updatedAt'])
        && request.resource.data.currentSequence >= resource.data.get('currentSequence', 0)
        && (isEmployeeCounter() || request.resource.data.currentSequence <= resource.data.get('currentSequence', 0) + 50)
      );

      allow delete: if isAdmin();
    }

    // ========================================================
    // 7. ID CARD ISSUER LOGIN (`staff/{uid}`)
    // Managed by the admin from /admin; the issuer can only read its own record
    // ========================================================
    match /staff/{uid} {
      allow get: if isAdmin() || (isAuthenticated() && request.auth.uid == uid);
      allow list, create, update, delete: if isAdmin();
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
