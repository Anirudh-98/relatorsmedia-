rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@realtorsmedia.com';
    }

    // Active ID card issuer (see `staff` in firestore.rules)
    function isIssuer() {
      let staffPath = /databases/(default)/documents/staff/$(request.auth.uid);
      return request.auth != null && firestore.exists(staffPath) && firestore.get(staffPath).data.active == true;
    }

    // Raster images only: SVG can carry scripts
    function isImageUnder(maxBytes) {
      return request.resource.size < maxBytes
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    // ID card photos: `members/{uid}/...` for members, `members/employee_{id}/...` for employee cards.
    // Each photo is readable by its URL (ID cards and QR verification) but folders cannot be listed;
    // files are never overwritten or deleted except by the admin
    match /members/{ownerId}/{allPaths=**} {
      allow get: if true;
      allow create: if isImageUnder(10 * 1024 * 1024) && (
        (request.auth != null && request.auth.uid == ownerId)
        || (ownerId.matches('employee_.*') && (isAdmin() || isIssuer()))
      );
      allow update, delete: if isAdmin();
    }

    // Property images: uploaded by the admin with the listing (Max 5MB per photo)
    match /properties/{allPaths=**} {
      allow get: if true;
      allow create: if isAdmin() && isImageUnder(5 * 1024 * 1024);
      allow update, delete: if isAdmin();
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
