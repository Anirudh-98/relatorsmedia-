rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Member photos: public read for ID cards and verification, upload allowed
    match /members/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    
    // Property images: public read, upload allowed
    match /properties/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
